# IMAP mail client - account definitions
# Copy to:  <this project>/.env        <- recommended, gitignored
#       or:  %USERPROFILE%/.mailclient/accounts.env
#       or:  point MAIL_ENV_FILE at any path.

# One block per mailbox. The name between MC__ and the field suffix is
# arbitrary; it is lowercased for --account.
#
# Required: HOST, PORT, USER, PASSWORD
# Optional: SENT, JUNK, BOUNCES, TLS (implicit|starttls)

# ---- Hostinger dev mailbox ----
# MC__DEV_HOST=imap.hostinger.com
# MC__DEV_PORT=993
# MC__DEV_USER=dev@w57th.agency
# MC__DEV_PASSWORD=replace-me
# MC__DEV_SENT=INBOX.Sent
# MC__DEV_JUNK=INBOX.Spam
# MC__DEV_BOUNCES=INBOX.Bounces

# ---- second Hostinger mailbox ----
# MC__OPS_HOST=imap.hostinger.com
# MC__OPS_PORT=993
# MC__OPS_USER=ops@w57th.agency
# MC__OPS_PASSWORD=replace-me

# ---- non-Hostinger provider ----
# MC__GMAIL_HOST=imap.gmail.com
# MC__GMAIL_PORT=993
# MC__GMAIL_USER=you@gmail.com
# MC__GMAIL_PASSWORD=app-specific-password
# MC__GMAIL_SENT=[Gmail]/Sent Mail
# MC__GMAIL_JUNK=[Gmail]/Spam

# Default when several are configured and -a is omitted:
# MAIL_DEFAULT_ACCOUNT=dev
